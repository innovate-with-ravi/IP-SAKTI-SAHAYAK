# Primary LLM & Embeddings (Google GenAI)
GOOGLE_API_KEY=your_google_api_key_here

# Fast Router / Fallback LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333 # replace with live url
QDRANT_API_KEY=
